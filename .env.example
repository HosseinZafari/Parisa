# همهٔ مقادیر محرمانه فقط در بک‌اند خوانده می‌شوند.
APP_ENV=local
DATABASE_URL=sqlite:///./data/parisa.db
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SEED_DEMO=true
SELLER_USERNAME=parisa
SELLER_PASSWORD=parisa-demo-1405
LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_MESSAGES=160
MAX_LLM_REQUESTS=40
CHAT_REQUESTS_PER_MINUTE=30
PAYMENT_MODE=mock
PAYMENT_SECRET=local-only-replace-before-deployment
PAYMENT_LINK_MINUTES=30
INSTAGRAM_MODE=mock
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_SENDS_PER_MINUTE=20
BUSINESS_TIMEZONE=Asia/Tehran
